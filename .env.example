# Application
APP_ENV=production
API_PORT=8000

# MySQL
MYSQL_DATABASE=job_agent
MYSQL_USER=job_agent
MYSQL_PASSWORD=replace_with_a_long_random_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_long_random_password

# Generate with: openssl rand -hex 32. Keep this key separate from database backups.
PROFILE_ENCRYPTION_KEY=replace_with_a_64_character_hex_key

# Ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b

# Automatically scan saved company pages every 15-1440 minutes (default: 60).
SCAN_INTERVAL_MINUTES=60
NEW_JOB_WINDOW_HOURS=48
